@page
@model Velora.Core.Pages.Account.RegisterModel
@{ ViewData["Title"]="Kayıt Ol"; }
@section Styles { <link rel="stylesheet" href="~/css/login.css" /> }
<section class="box"><h1>Hesap Oluştur</h1><form method="post"><div asp-validation-summary="ModelOnly" class="error"></div><input asp-for="Input.FullName" placeholder="Ad Soyad"/><span asp-validation-for="Input.FullName" class="error"></span><input asp-for="Input.Email" placeholder="E-posta"/><span asp-validation-for="Input.Email" class="error"></span><input asp-for="Input.Password" placeholder="Şifre"/><span asp-validation-for="Input.Password" class="error"></span><input asp-for="Input.ConfirmPassword" placeholder="Şifre Tekrar"/><span asp-validation-for="Input.ConfirmPassword" class="error"></span><button class="submit">Kayıt Ol</button></form><p><a href="/Account/Login">Zaten üye misiniz? Giriş yapın</a></p></section>
