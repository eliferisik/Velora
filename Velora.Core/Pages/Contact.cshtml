@page
@model ContactModel
@{ ViewData["Title"] = "İletişim"; }
@section Styles { <link rel="stylesheet" href="~/css/iletisim.css" /> }
<section class="contact-page"><div class="contact-left"><span class="mini-title">VELORA</span><h1>Bizimle İletişime Geç</h1><p>Sorularınız, önerileriniz veya iş birlikleri için bizimle iletişime geçebilirsiniz.</p><div class="contact-info"><div class="info-box"><h3>Email</h3><span>hello@velora.com</span></div><div class="info-box"><h3>Telefon</h3><span>+90 555 555 55 55</span></div><div class="info-box"><h3>Instagram</h3><span>@@veloraofficial</span></div></div></div><div class="contact-right"><h2>Mesaj Gönder</h2>@if(Model.Sent){<p class="success-message" role="status">Formunuz başarıyla doğrulandı.</p>}<form method="post"><div asp-validation-summary="ModelOnly" class="error"></div><input asp-for="Name" placeholder="Adınız"/><span asp-validation-for="Name" class="error"></span><input asp-for="Email" placeholder="Email"/><span asp-validation-for="Email" class="error"></span><input asp-for="Subject" placeholder="Konu"/><span asp-validation-for="Subject" class="error"></span><textarea asp-for="Message" placeholder="Mesajınız"></textarea><span asp-validation-for="Message" class="error"></span><button type="submit">Gönder</button></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
