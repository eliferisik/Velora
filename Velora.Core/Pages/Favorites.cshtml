@page
@{ ViewData["Title"] = "Favorilerim"; }
@section Styles { <link rel="stylesheet" href="~/css/elbise.css" /><link rel="stylesheet" href="~/css/favoriler.css" /> }
<div class="favorites-page"><div class="favorites-header"><span>VELORA FAVORITES</span><h1>Favorilerim</h1><p>Favorilere eklediğiniz ürünler burada görünür.</p></div><div id="favorites-container" class="favorites-grid"></div></div>
@section Scripts { <script>
const box=document.getElementById('favorites-container');
function getPrice(raw){let value=String(raw??'').replace(/[^\d,.-]/g,'');value=value.replace(/\.(?=\d{3}(?:\D|$))/g,'').replace(',','.');const number=Number(value);return Number.isFinite(number)?new Intl.NumberFormat('tr-TR',{style:'currency',currency:'TRY',maximumFractionDigits:0}).format(number):'Fiyat bilgisi yok'}
function drawFavorites(){const items=JSON.parse(localStorage.getItem('favorites')||'[]');box.replaceChildren();if(!items.length){const empty=document.createElement('div');empty.className='empty-favorites';empty.innerHTML='<h2>Henüz favori ürününüz bulunmamaktadır 🤍</h2><p>Beğendiğiniz ürünleri favorilere ekleyebilirsiniz.</p><a href="/Products">Ürünleri Keşfet</a>';box.append(empty);return;}for(const p of items){const card=document.createElement('article');card.className='dress-card product-card-clickable';card.tabIndex=0;card.setAttribute('role','link');card.setAttribute('aria-label',p.name+' ürün detayını aç');card.dataset.detailUrl='/Products/Details/'+encodeURIComponent(p.id);const image=document.createElement('div');image.className='dress-image';const remove=document.createElement('button');remove.className='favorite-btn active';remove.type='button';remove.textContent='♥';remove.setAttribute('aria-label','Favorilerden kaldır');remove.title='Favorilerden kaldır';remove.onclick=e=>{e.stopPropagation();localStorage.setItem('favorites',JSON.stringify(items.filter(x=>x.id!==p.id)));drawFavorites()};const img=document.createElement('img');img.className='main-img';img.src=p.image;img.alt=p.name;const hover=document.createElement('img');hover.className='hover-img';hover.src=p.hoverImage||p.image;hover.alt='';image.append(remove,img,hover);const info=document.createElement('div');info.className='dress-info';const label=document.createElement('span');label.textContent='VELORA FAVORITE';const name=document.createElement('h3');name.textContent=p.name;const price=document.createElement('p');price.textContent=getPrice(p.price);info.append(label,name,price);card.append(image,info);card.addEventListener('click',()=>location.href=card.dataset.detailUrl);card.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();location.href=card.dataset.detailUrl}});box.append(card)}}drawFavorites();
</script> }
