@page "/hero"
@{
    Layout = null;
    ViewData["Title"] = "VELORA | New Collection";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/hero.css" />
</head>
<body>
    <main class="intro">
        <img src="~/images/velorahero.png" class="intro-bg" alt="Velora yeni koleksiyon" />
        <div class="overlay"></div>
        <div class="intro-content">
            <h1>VELORA</h1>
            <p>NEW COLLECTION</p>
            <a href="/" class="enter-btn">KOLEKSİYONU KEŞFET</a>
        </div>
    </main>
</body>
</html>
