@page
@model Velora.Core.Pages.Products.IndexModel
@{ ViewData["Title"] = "Ürünler | Velora"; }
@section Styles { <link rel="stylesheet" href="~/css/elbise.css" /> }
<section class="dress-page"><div class="dress-layout">
    <aside class="dress-sidebar"><h2>Kategoriler</h2><ul><li><a href="/Products">Tüm ürünler</a></li>@foreach (var c in Model.Categories) { <li><a href="/Products?category=@c.Id">@c.Name</a></li> }</ul></aside>
    <div class="dress-content"><div class="page-header"><span>VELORA COLLECTION</span><h1>Ürünler</h1><p>Zamansız, modern ve premium koleksiyon.</p></div>
        <form method="get" class="product-filters"><input name="q" value="@Model.Query" placeholder="Ürün ara"/><select name="category"><option value="">Tüm kategoriler</option>@foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option> }</select><select name="sort"><option value="">Önerilen</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Fiyat artan</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Fiyat azalan</option><option value="top" selected="@(Model.Sort == "top")">En çok satılan</option></select><button type="submit">Filtrele</button></form>
        <div class="dress-grid">@foreach (var p in Model.Products) { <article class="dress-card product-card-clickable" data-product-card data-detail-url="/Products/Details/@p.Id" tabindex="0" role="link" aria-label="@p.Name ürün detayını aç"><div class="dress-image"><button type="button" class="favorite-btn" data-favorite data-id="@p.Id" data-name="@p.Name" data-price="@p.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-image="/@p.Image" data-hover="/@(p.HoverImage ?? p.Image)" aria-label="Favorilere ekle">♡</button><img src="/@p.Image" class="main-img" alt="@p.Name"/><img src="/@(p.HoverImage ?? p.Image)" class="hover-img" alt=""/></div><div class="dress-info"><span>@p.Category?.Name</span><h3>@p.Name</h3><p>@p.Price.ToString("C0", new System.Globalization.CultureInfo("tr-TR"))</p></div></article> }</div>
        @if (!Model.Products.Any()) { <p>Aramanıza uygun ürün bulunamadı.</p> }
    </div>
</div></section>
@section Scripts { <script>document.querySelectorAll('[data-favorite]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();let a=JSON.parse(localStorage.getItem('favorites')||'[]');const p={id:b.dataset.id,name:b.dataset.name,price:b.dataset.price,image:b.dataset.image,hoverImage:b.dataset.hover};if(!a.some(x=>x.id===p.id))a.push(p);localStorage.setItem('favorites',JSON.stringify(a));b.textContent='♥';b.classList.add('active')}));document.querySelectorAll('[data-product-card]').forEach(c=>{c.addEventListener('click',e=>{if(!e.target.closest('button'))location.href=c.dataset.detailUrl});c.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&!e.target.closest('button')){e.preventDefault();location.href=c.dataset.detailUrl}})});</script> }
